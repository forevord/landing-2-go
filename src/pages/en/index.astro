---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import Hero from '../../components/Hero.astro';
import Services from '../../components/Services.astro';
import Gallery from '../../components/Gallery.astro';
import Objections from '../../components/Objections.astro';
import WhyUs from '../../components/WhyUs.astro';
import Process from '../../components/Process.astro';
import Faq from '../../components/Faq.astro';
import Safety from '../../components/Safety.astro';
import Testimonials from '../../components/Testimonials.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import StickyCta from '../../components/StickyCta.astro';
import { getDictionary } from '../../i18n';

const locale = 'en' as const;
const t = getDictionary(locale);
// From the ALU3 change request; unconfirmed until _meta.demo is cleared.
const phone = '+48 510 318 834';
const email = 'biuro@alu3.pl';
---

<Base
  locale={locale}
  routeKey="home"
  title={t.seo.title}
  description={t.seo.description}
  ogTitle={t.seo.ogTitle}
  ogDescription={t.seo.ogDescription}
  ogImageAlt={t.seo.ogImageAlt}
>
  <TopBar locale={locale} routeKey="home" phone={phone} />
  <main id="main" tabindex="-1">
    <Hero locale={locale} phone={phone} />
    <Services locale={locale} />
    <Gallery locale={locale} />
    <Objections locale={locale} />
    <WhyUs locale={locale} />
    <Process locale={locale} />
    <Faq locale={locale} />
    <Safety locale={locale} />
    <Testimonials locale={locale} />
    <Contact locale={locale} phone={phone} email={email} />
  </main>
  <Footer locale={locale} />
  <StickyCta locale={locale} phone={phone} />
</Base>
