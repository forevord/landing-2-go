---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import Hero from '../../components/Hero.astro';
import Promises from '../../components/Promises.astro';
import QuickQuote from '../../components/QuickQuote.astro';
import Services from '../../components/Services.astro';
import Arguments from '../../components/Arguments.astro';
import Process from '../../components/Process.astro';
import Gallery from '../../components/Gallery.astro';
import Testimonials from '../../components/Testimonials.astro';
import Faq from '../../components/Faq.astro';
import FormSection from '../../components/FormSection.astro';
import Contacts from '../../components/Contacts.astro';
import Footer from '../../components/Footer.astro';
import StickyCta from '../../components/StickyCta.astro';
import { getDictionary } from '../../i18n';

const locale = 'en' as const;
const t = getDictionary(locale);
// Replaced by {{TELEFON}} / {{EMAIL}} in Task 18.
const phone = '+48 601 234 567';
const email = 'biuro@stalbruk.pl';
---

<Base
  locale={locale}
  routeKey="home"
  title={t.seo.title}
  description={t.seo.description}
  ogTitle={t.seo.ogTitle}
  ogDescription={t.seo.ogDescription}
  ogImageAlt={t.seo.ogImageAlt}
>
  <TopBar locale={locale} routeKey="home" phone={phone} variant="overlay" />
  <main id="main" tabindex="-1" class="pb-24 md:pb-0">
    <Hero locale={locale} phone={phone} />
    <Promises locale={locale} />
    <Services locale={locale} />
    <QuickQuote locale={locale} />
    <Gallery locale={locale} />
    <Testimonials locale={locale} />
    <Arguments locale={locale} />
    <Process locale={locale} />
    <Faq locale={locale} />
    <FormSection locale={locale} phone={phone} />

    <Contacts locale={locale} phone={phone} email={email} />
  </main>
  <Footer locale={locale} />
  <StickyCta locale={locale} phone={phone} />
</Base>
