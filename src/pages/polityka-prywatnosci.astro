---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import { getDictionary } from '../i18n';

const locale = 'pl' as const;
const t = getDictionary(locale);
const phone = '+48 601 234 567'; // Demo value; see _meta.demo in the dictionaries.
---

<Base locale={locale} routeKey="privacy" title={t.privacy.seoTitle} description={t.privacy.title}>
  <TopBar locale={locale} routeKey="privacy" phone={phone} />
  <main id="main" tabindex="-1" class="mx-auto max-w-[720px] px-4 py-24">
    <h1 class="text-[clamp(2rem,5vw,3rem)] font-bold tracking-[-0.015em] text-ink">
      {t.privacy.title}
    </h1>
    <article class="prose mt-6 max-w-none text-muted">
      <p>{t.privacy.body}</p>
    </article>
  </main>
  <Footer locale={locale} />
</Base>
