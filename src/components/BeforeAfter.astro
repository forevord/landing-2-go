---
import { Image } from 'astro:assets';
import { getDictionary, type Locale } from '../i18n';
import beforePhoto from '../assets/photos/before-driveway.jpg';
import afterPhoto from '../assets/photos/after-driveway.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ba = getDictionary(locale).gallery.beforeAfter;
---

{
  /* Demo pair: two unrelated stock photographs, not one site shot twice. See
    the warning in src/assets/photos/CREDITS.md before launch. */
}
<figure>
  <figcaption class="mb-4 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <span class="font-display text-[1.2rem] font-bold">{ba.title}</span>
    <span class="text-[0.85rem] text-body">{ba.hint}</span>
  </figcaption>

  <div
    class="relative aspect-video w-full touch-pan-y overflow-hidden border border-line-light bg-ink select-none"
    data-before-after
  >
    <Image
      src={beforePhoto}
      alt={ba.beforeAlt}
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 1080px) 1024px, 100vw"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <Image
      src={afterPhoto}
      alt={ba.afterAlt}
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 1080px) 1024px, 100vw"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
      data-after
      style="clip-path: inset(0 0 0 50%)"
    />

    <input
      type="range"
      min="0"
      max="100"
      value="50"
      class="absolute inset-0 h-full w-full cursor-ew-resize opacity-0"
      aria-label={ba.hint}
      data-range
    />

    <span
      class="pointer-events-none absolute inset-y-0 w-0.5 bg-white"
      data-handle
      style="left: 50%"></span>

    {
      /* The labels sit after the range input in the DOM and ignore pointer
        events, so dragging still works across them. */
    }
    <span
      class="pointer-events-none absolute top-4 left-4 bg-ink/75 px-2.5 py-1.5 text-xs font-semibold text-white"
    >
      {ba.beforeLabel}
    </span>
    <span
      class="pointer-events-none absolute top-4 right-4 bg-ink/75 px-2.5 py-1.5 text-xs font-semibold text-white"
    >
      {ba.afterLabel}
    </span>
  </div>
</figure>

<script>
  import '../scripts/before-after';
</script>
