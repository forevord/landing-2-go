---
import Icon from './Icon.astro';
import { getDictionary, otherLocale, route, type Locale, type RouteKey } from '../i18n';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  phone: string;
}

const { locale, routeKey, phone } = Astro.props;
const t = getDictionary(locale);
const other = otherLocale(locale);
const otherHref = route(routeKey, other);
const telHref = `tel:${phone.replace(/\s/g, '')}`;

// The mockup sets the brand's final figure in the accent: ALU + 3.
const brand = t.topbar.brand;
const brandHead = brand.slice(0, -1);
const brandTail = brand.slice(-1);
---

<header class="site-header">
  <div class="wrap flex items-center justify-between gap-4 py-[18px]">
    <a href={route('home', locale)} class="logo" aria-label={brand}>
      {brandHead}<span>{brandTail}</span>
    </a>

    <div class="flex items-center gap-2 sm:gap-4">
      <a
        href={otherHref}
        hreflang={other}
        class="flex min-h-11 items-center gap-1.5 px-2 text-sm font-semibold text-steel hover:text-paper"
        aria-label={t.topbar.langSwitchTo}
      >
        <Icon name="globe" class="h-4 w-4" />
        {other.toUpperCase()}
      </a>
      <a href={telHref} class="header-phone" aria-label={t.topbar.phoneAria}>{phone}</a>
    </div>
  </div>
</header>
