---
import Icon from './Icon.astro';
import { getDictionary, otherLocale, route, type Locale, type RouteKey } from '../i18n';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  phone: string;
  /** `overlay` floats the bar on a dark hero; `solid` is for pages without one. */
  variant?: 'overlay' | 'solid';
}

const { locale, routeKey, phone, variant = 'solid' } = Astro.props;
const isOverlay = variant === 'overlay';
const headerClass = isOverlay
  ? 'sticky top-0 z-40'
  : 'sticky top-0 z-40 bg-ink text-surface';
const t = getDictionary(locale);
const other = otherLocale(locale);
const otherHref = route(routeKey, other);
const telHref = `tel:${phone.replace(/\s/g, '')}`;

// The dictionary carries a {{TELEFON}} token; substituting the real number keeps
// the accessible name containing the visible text, as WCAG 2.5.3 requires.
const phoneAria = t.topbar.phoneAria.replace('{{TELEFON}}', phone);
---

{/* Transparent over the hero rather than a solid bar, so the veiled photograph
    and the header read as one field, then paper white once the page moves —
    the reference's own scroll behaviour. Nothing here is dimmed: over the veil,
    75% black measures 4.06:1, and on the solid variant it was black on a black
    bar and could not be read at all. */}
{isOverlay && <div data-topbar-sentinel aria-hidden="true" class="h-px w-full"></div>}
<header class={headerClass} data-topbar={isOverlay ? '' : undefined}>
  <div class="mx-auto flex h-20 max-w-page items-center gap-6 px-6 lg:px-10">
    <a href={route('home', locale)} class="text-lg font-medium">
      {t.topbar.brand}
    </a>

    <span class="hidden items-center gap-1.5 text-sm md:flex">
      <Icon name="map-pin" class="h-4 w-4" />
      {t.topbar.location}
    </span>

    <div class="ml-auto flex items-center gap-1 sm:gap-4">
      <a
        href={telHref}
        class="flex min-h-11 items-center gap-2 px-2 text-sm tracking-tight"
        aria-label={phoneAria}
      >
        <Icon name="phone" class="h-4 w-4" />
        <span class="hidden lg:inline">{phone}</span>
      </a>

      <a
        href={otherHref}
        hreflang={other}
        class="t-label flex min-h-11 items-center px-2"
        aria-label={t.topbar.langSwitchTo}
      >
        {other.toUpperCase()}
      </a>

      <a href="#formularz" class="btn btn-soft hidden h-11 min-h-11 sm:inline-flex">
        <span>{t.topbar.cta}</span>
      </a>
    </div>
  </div>
  <hr class="mx-6 border-0 border-t border-current/25 lg:mx-10" />
</header>

<script>
  // Paper white once the sentinel above the bar leaves the viewport. An
  // observer rather than a scroll listener, so nothing runs per frame.
  const bar = document.querySelector<HTMLElement>('[data-topbar]');
  const sentinel = document.querySelector('[data-topbar-sentinel]');
  if (bar && sentinel) {
    new IntersectionObserver(([entry]) => {
      bar.toggleAttribute('data-stuck', !entry.isIntersecting);
    }).observe(sentinel);
  }
</script>
