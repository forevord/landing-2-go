---
import SectionHeading from './SectionHeading.astro';
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

{
  /* The strongest objection in this trade is "they will take the deposit and
    disappear". These four facts answer it together, directly above the form,
    where the visitor decides. */
}
<section class="band bg-paper-dim">
  <div class="wrap">
    <SectionHeading kicker={t.safety.kicker} title={t.safety.title} />

    <ul class="four-up">
      {
        t.safety.items.map((item, index) => (
          <li data-reveal style={`transition-delay:${index * 50}ms`}>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
