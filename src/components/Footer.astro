---
import { getDictionary, route, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const year = new Date().getFullYear();
const brand = t.topbar.brand;
---

<footer class="site-footer pb-24 md:pb-[30px]">
  <div class="wrap flex flex-wrap justify-between gap-x-6 gap-y-2.5">
    <p>
      {brand} — {t.footer.company} · {t.footer.address} · {t.footer.nip} ·{' '}
      <a href={route('privacy', locale)} class="underline hover:text-paper">{t.footer.privacy}</a>
    </p>
    <p>© {year} {brand}</p>
  </div>
</footer>
