---
import { getDictionary, route, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const year = new Date().getFullYear();
---

{
  /* The reference's footer is paper white with a hairline top rule. It also ends
    the page on a light band, so the graphite contacts section above it reads as
    a block rather than as the start of an unbroken dark tail. */
}
<footer class="border-t border-border pt-16 pb-24 text-muted md:pb-12">
  <div class="mx-auto max-w-page px-6 lg:px-10">
    <p class="text-2xl font-bold tracking-tight text-ink">{t.topbar.brand}</p>

    <div class="mt-8 grid gap-10 border-t border-border pt-8 md:grid-cols-2">
      <div>
        <p class="max-w-[40ch]">{t.footer.tagline}</p>
        <p class="mt-4 text-sm">{t.footer.company}</p>
        <p class="text-sm">{t.footer.address}</p>
        <p class="text-sm">{t.footer.nip}</p>
      </div>

      <nav aria-label={t.footer.navTitle}>
        <p class="t-label text-muted">{t.footer.navTitle}</p>
        <ul class="mt-4 grid gap-2 text-sm">
          {
            t.footer.nav.map((item) => (
              <li>
                <a href={item.href} class="hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li><a href={route('privacy', locale)} class="hover:text-ink">{t.footer.privacy}</a></li>
        </ul>
      </nav>
    </div>

    <div class="mt-8 border-t border-border pt-6 text-xs">
      © {year}
      {t.topbar.brand}. {t.footer.rights}
    </div>
  </div>
</footer>
