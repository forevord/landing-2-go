---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { getDictionary, type Locale } from '../i18n';
import gatePhoto from '../assets/photos/hero.jpg';
import pavingPhoto from '../assets/photos/paving.jpg';
import earthworksPhoto from '../assets/photos/earthworks.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

const IMAGES: Record<string, ImageMetadata> = {
  bramy: gatePhoto,
  brukarstwo: pavingPhoto,
  'pod-klucz': earthworksPhoto,
};

// Pre-selects the matching option in the full form.
const SERVICE_PARAM: Record<string, string> = {
  bramy: 'brama-przesuwna',
  brukarstwo: 'brukarstwo',
  'pod-klucz': 'pod-klucz',
};
---

{/* The canvas band. Every piece of type on it is obsidian — the muted grey
    used on paper measures 2.3:1 here and the reference's reversed white is
    worse still, so the hierarchy is carried by opacity on black instead. */}
<section id="uslugi" class="section bg-gunmetal text-ink">
  <div class="mx-auto max-w-page px-6 lg:px-10">
    <div class="split">
      <p class="t-label">{t.services.title}</p>
      <h2 class="t-h2 max-w-[26ch]">{t.services.lead}</h2>
    </div>

    <div class="mt-20 grid gap-16 lg:gap-24">
      {
        t.services.items.map((item, index) => (
          <article
            class="grid items-center gap-8 lg:grid-cols-2 lg:gap-16"
            data-reveal
            style={`transition-delay:${index * 50}ms`}
          >
            {/* The reference's product image card: the photograph sits inside a
                paper card on the canvas rather than bleeding into it. */}
            <div class={`rounded-card bg-surface p-5 ${index % 2 === 1 ? 'lg:order-2' : ''}`}>
              <div class="relative media aspect-[3/2]">
                <Image
                  src={IMAGES[item.id]}
                  alt={item.imageAlt}
                  widths={[480, 768, 1024]}
                  sizes="(min-width: 1024px) 50vw, 100vw"
                  loading="lazy"
                  quality={72}
                />
              </div>
            </div>
            <div class={index % 2 === 1 ? 'lg:order-1' : ''}>
              <span class="t-label text-ink/75">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="t-h2 mt-4">{item.title}</h3>
              <p class="t-lead mt-4 text-ink/75">{item.desc}</p>
              <ul class="mt-6 grid gap-2.5">
                {item.list.map((entry) => (
                  <li class="flex items-center gap-2.5">
                    <Icon name="check" class="h-4 w-4 shrink-0 text-ink/75" />
                    {entry}
                  </li>
                ))}
              </ul>
              <a
                href="#formularz"
                data-service={SERVICE_PARAM[item.id]}
                class="btn btn-primary mt-8"
              >
                {item.cta}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Clicking a service card pre-selects that service in the full form.
  // The href already points at #formularz, so this still works without JS —
  // the visitor simply picks the service themselves.
  document.querySelectorAll<HTMLAnchorElement>('a[data-service]').forEach((link) => {
    link.addEventListener('click', () => {
      const select = document.querySelector<HTMLSelectElement>('#full-form select[name="service"]');
      if (select) select.value = link.dataset.service ?? '';
    });
  });
</script>
