---
import SectionHeading from './SectionHeading.astro';
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

// Pre-selects the matching option in the form.
const SERVICE_PARAM: Record<string, string> = {
  bramy: 'brama-przesuwna',
  balustrady: 'balustrada',
  zadaszenia: 'zadaszenie',
};
---

<section id="uslugi" class="band bg-surface">
  <div class="wrap">
    <SectionHeading kicker={t.services.kicker} title={t.services.title} lead={t.services.lead} />

    <ul class="service-list" tabindex="0" aria-label={t.services.title}>
      {
        t.services.items.map((item) => (
          <li class="service">
            <p class="price">{item.price}</p>
            <h3>{item.title}</h3>
            <p class="service__desc">{item.desc}</p>
            <ul class="mb-4">
              {item.list.map((entry) => (
                <li>{entry}</li>
              ))}
            </ul>
            <a
              href="#formularz"
              data-service={SERVICE_PARAM[item.id]}
              data-cta-quote
              class="link-arrow mt-auto self-start"
            >
              {item.cta}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Clicking a service card pre-selects that service in the form. The href
  // already points at #formularz, so this still works without JS — the visitor
  // simply picks the service themselves.
  document.querySelectorAll<HTMLAnchorElement>('a[data-service]').forEach((link) => {
    link.addEventListener('click', () => {
      const value = link.dataset.service ?? '';
      document
        .querySelectorAll<HTMLSelectElement>('.lead-form select[name="service"]')
        .forEach((select) => {
          select.value = value;
        });
    });
  });
</script>
