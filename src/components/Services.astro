---
import { Image } from 'astro:assets';
import { getDictionary, type Locale } from '../i18n';
import gatePhoto from '../assets/photos/hero.jpg';
import pavingPhoto from '../assets/photos/paving.jpg';
import earthworksPhoto from '../assets/photos/earthworks.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

const IMAGES: Record<string, ImageMetadata> = {
  bramy: gatePhoto,
  brukarstwo: pavingPhoto,
  'pod-klucz': earthworksPhoto,
};

// Pre-selects the matching option in the full form.
const SERVICE_PARAM: Record<string, string> = {
  bramy: 'brama-przesuwna',
  brukarstwo: 'brukarstwo',
  'pod-klucz': 'pod-klucz',
};
---

{/* Composed against what the field actually does. Four Pomeranian gate and
    fencing sites were rendered and read: all four surface the whole offer as a
    flat grid a visitor can compare at a glance, and all four give every entry
    its own button. None uses an alternating zigzag of large rows, which is what
    this section was — it made a buyer scroll past each service in turn instead
    of weighing them against each other. None uses a tick-marked feature list
    either; scope is set in the buyer's own vocabulary.

    Where the whole field falls down is facts: not one of the four publishes a
    price, a lead time or a warranty beside the offer. Every one says "free
    quote" and makes you telephone. Those facts already existed here, buried in
    the FAQ accordion at the foot of the page. The strip below moves them to
    where the decision is actually made. */}
<section id="uslugi" class="section">
  <div class="mx-auto max-w-page px-6 lg:px-10">
    <div class="split">
      <p class="t-label text-ink">{t.services.title}</p>
      <h2 class="t-h2 max-w-[26ch] text-ink">{t.services.lead}</h2>
    </div>

    <dl class="mt-14 grid gap-px overflow-hidden rounded-card border border-border bg-border sm:grid-cols-3">
      {
        t.services.promises.map((promise) => (
          <div class="bg-surface px-6 py-5">
            <dt class="t-label text-muted">{promise.label}</dt>
            <dd class="mt-1 font-medium text-ink">{promise.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-6 grid gap-6 md:grid-cols-3">
      {
        t.services.items.map((item, index) => (
          <article
            class="flex flex-col overflow-hidden rounded-card border border-border"
            data-reveal
            style={`transition-delay:${index * 50}ms`}
          >
            {/* The photograph fills the head of the card rather than floating
                inside a white mat, so the card reads as one object. */}
            <div class="relative media aspect-[3/2] rounded-none">
              <Image
                src={IMAGES[item.id]}
                alt={item.imageAlt}
                widths={[400, 640, 800]}
                sizes="(min-width: 768px) 33vw, 100vw"
                loading="lazy"
                quality={72}
              />
            </div>

            <div class="flex flex-1 flex-col p-6">
              <h3 class="t-h3 text-ink">{item.title}</h3>
              <p class="mt-3 text-muted">{item.desc}</p>

              {/* Scope set as the words a buyer searches for, on hairlines.
                  No site in the field uses tick marks. The bottom margin here
                  rather than on the button: the button is pinned to the foot of
                  the card with mt-auto, because the three descriptions differ
                  by a line and the actions would otherwise sit at three
                  different heights across the row. */}
              <ul class="mt-6 mb-6 grid border-t border-border text-sm">
                {item.list.map((entry) => (
                  <li class="border-b border-border py-2.5 text-ink">{entry}</li>
                ))}
              </ul>

              <a
                href="#formularz"
                data-service={SERVICE_PARAM[item.id]}
                class="btn btn-primary mt-auto w-full"
              >
                {item.cta}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Clicking a service card pre-selects that service in the full form.
  // The href already points at #formularz, so this still works without JS —
  // the visitor simply picks the service themselves.
  document.querySelectorAll<HTMLAnchorElement>('a[data-service]').forEach((link) => {
    link.addEventListener('click', () => {
      const select = document.querySelector<HTMLSelectElement>('#full-form select[name="service"]');
      if (select) select.value = link.dataset.service ?? '';
    });
  });
</script>
