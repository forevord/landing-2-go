---
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section class="section bg-gunmetal text-ink">
  <div class="mx-auto max-w-page px-6 lg:px-10">
    <div class="split">
      <p class="t-label">{t.why.title}</p>

      <div>
        <h2 class="t-h2 max-w-[26ch]">{t.why.lead}</h2>

        <ul class="mt-12 grid gap-0 sm:grid-cols-2 sm:gap-x-6">
          {
            t.why.items.map((item, index) => (
              <li
                class="border-t border-ink/20 py-8"
                data-reveal
                style={`transition-delay:${index * 50}ms`}
              >
                <span class="t-h2 text-ink/60">{String(index + 1).padStart(2, '0')}</span>
                <h3 class="t-h3 mt-4">{item.title}</h3>
                <p class="mt-2 text-ink/75">{item.desc}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
