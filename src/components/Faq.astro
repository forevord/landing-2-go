---
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section id="faq" class="mx-auto max-w-[840px] px-6 py-24 lg:px-10 lg:py-32">
  <h2 class="t-h2 text-ink">{t.faq.title}</h2>
  <p class="mt-4 text-muted">{t.faq.lead}</p>

  <div class="mt-12 divide-y divide-border border-y border-border">
    {
      t.faq.items.map((item) => (
        <details class="faq-item group">
          <summary class="faq-summary t-h3 flex min-h-14 cursor-pointer items-center justify-between gap-4 py-7 text-ink">
            {item.q}
            <span class="shrink-0 text-muted transition-transform duration-200 group-open:rotate-45">+</span>
          </summary>
          <div class="faq-body">
            <p class="overflow-hidden pb-7 text-muted">{item.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  /* Chromium honors list-style:none on summary; Safari needs the
     WebKit-specific pseudo hidden too, or its triangle doubles up with the +. */
  .faq-summary {
    list-style: none;
  }
  .faq-summary::-webkit-details-marker {
    display: none;
  }

  /* Animating grid-template-rows avoids the layout thrash of animating height. */
  .faq-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 200ms var(--ease-out);
  }
  details[open] .faq-body {
    grid-template-rows: 1fr;
  }
</style>
