---
import { getDictionary, route, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  id: string;
}

const { locale, id } = Astro.props;
const t = getDictionary(locale);
const f = t.form;
const privacyHref = route('privacy', locale);

// Only the strings the island needs at runtime. Passing them as data avoids
// shipping both dictionaries to the browser for six error messages.
const clientMessages = {
  errors: f.errors,
  submitting: f.submitting,
};

// The campaign fields the form carries invisibly. Filled by scripts/tracking.ts
// on load; empty when the visitor arrived without any of them.
const TRACKING_FIELDS = [
  'utm_source',
  'utm_medium',
  'utm_campaign',
  'utm_term',
  'utm_content',
  'gclid',
  'page_url',
] as const;
---

{
  /* Sits on the graphite contact band: underlined fields, no card and no
    shadow, as the mockup draws it. Every field of the previous form is kept —
    the endpoint and the Telegram message expect them. */
}
<form
  id={id}
  class="lead-form relative grid gap-5"
  data-variant="full"
  data-messages={JSON.stringify(clientMessages)}
  novalidate
>
  <div class="grid gap-5 sm:grid-cols-2">
    <label class="grid content-start">
      <span class="field-label">{f.fields.name.label}</span>
      <input
        type="text"
        name="name"
        autocomplete="given-name"
        placeholder={f.fields.name.placeholder}
        required
        aria-describedby={`${id}-name-error`}
      />
      <span
        class="error mt-1.5 text-sm"
        id={`${id}-name-error`}
        data-error-for="name"
        aria-live="polite"></span>
    </label>

    <label class="grid content-start">
      <span class="field-label">{f.fields.phone.label}</span>
      <input
        type="tel"
        name="phone"
        inputmode="tel"
        autocomplete="tel"
        placeholder={f.fields.phone.placeholder}
        required
        aria-describedby={`${id}-phone-hint ${id}-phone-error`}
      />
      <span class="mt-1.5 text-xs text-steel" id={`${id}-phone-hint`}>{f.fields.phone.hint}</span>
      <span
        class="error mt-1.5 text-sm"
        id={`${id}-phone-error`}
        data-error-for="phone"
        aria-live="polite"></span>
    </label>
  </div>

  <label class="grid content-start">
    <span class="field-label">{f.fields.service.label}</span>
    <select name="service" required aria-describedby={`${id}-service-error`}>
      <option value="">{f.fields.service.placeholder}</option>
      {f.serviceOptions.map((o) => <option value={o.value}>{o.label}</option>)}
    </select>
    <span
      class="error mt-1.5 text-sm"
      id={`${id}-service-error`}
      data-error-for="service"
      aria-live="polite"></span>
  </label>

  <div class="grid gap-5 sm:grid-cols-2">
    <label class="grid content-start">
      <span class="field-label">{f.fields.city.label}</span>
      <input
        type="text"
        name="city"
        autocomplete="address-level2"
        placeholder={f.fields.city.placeholder}
        required
        aria-describedby={`${id}-city-error`}
      />
      <span
        class="error mt-1.5 text-sm"
        id={`${id}-city-error`}
        data-error-for="city"
        aria-live="polite"></span>
    </label>

    <label class="grid content-start">
      <span class="field-label">{`${f.fields.email.label} (${f.fields.email.optional})`}</span>
      <input
        type="email"
        name="email"
        autocomplete="email"
        placeholder={f.fields.email.placeholder}
        aria-describedby={`${id}-email-error`}
      />
      <span
        class="error mt-1.5 text-sm"
        id={`${id}-email-error`}
        data-error-for="email"
        aria-live="polite"></span>
    </label>
  </div>

  <label class="grid content-start">
    <span class="field-label">{`${f.fields.message.label} (${f.fields.message.optional})`}</span>
    <textarea name="message" rows="3" placeholder={f.fields.message.placeholder}></textarea>
  </label>

  <div>
    <label class="flex items-start gap-3 text-sm text-on-dark">
      <input
        type="checkbox"
        name="gdpr"
        class="mt-0.5 h-5 w-5 shrink-0"
        required
        aria-describedby={`${id}-gdpr-error`}
      />
      <span>
        {f.fields.gdpr.label}{' '}
        <a href={privacyHref} class="underline">{f.fields.gdpr.linkText}</a>
      </span>
    </label>
    <span
      class="error mt-1.5 block text-sm"
      id={`${id}-gdpr-error`}
      data-error-for="gdpr"
      aria-live="polite"></span>
  </div>

  {/* Honeypot: hidden from humans, irresistible to bots. */}
  <div
    class="pointer-events-none absolute left-[-9999px] h-0 w-0 overflow-hidden"
    aria-hidden="true"
  >
    <label>
      Leave this field empty
      <input type="text" name="hp" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <input type="hidden" name="source" value="full" />
  <input type="hidden" name="thanks" value={route('thanks', locale)} />
  {TRACKING_FIELDS.map((field) => <input type="hidden" name={field} value="" data-tracking />)}

  <div>
    <button type="submit" class="btn btn-primary" data-submit>
      <span data-submit-label>{f.submit}</span>
    </button>
    <p class="mt-3 text-xs text-steel">{f.microcopy}</p>
  </div>

  <p
    class="hidden border border-error-on-dark p-3 text-sm text-error-on-dark"
    data-form-error
    role="alert"
  >
  </p>
</form>

<script>
  import '../scripts/tracking';
  import '../scripts/form';
</script>
