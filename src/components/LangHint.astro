---
import { getDictionary, otherLocale, route, type Locale, type RouteKey } from '../i18n';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
}

const { locale, routeKey } = Astro.props;
const t = getDictionary(locale);
const target = route(routeKey, otherLocale(locale));
---

<div
  class="hidden items-center justify-center gap-4 bg-cta px-4 py-2 text-sm text-white"
  data-lang-hint
  data-page-locale={locale}
>
  <span>{t.langHint.message}</span>
  <a class="underline" href={target}>{t.langHint.cta}</a>
  <button type="button" class="ml-auto px-2 underline" data-lang-hint-dismiss>
    <span class="sr-only">{t.langHint.dismiss}</span>
    <span aria-hidden="true">&times;</span>
  </button>
</div>
