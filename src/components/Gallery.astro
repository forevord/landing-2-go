---
import SectionHeading from './SectionHeading.astro';
import ProjectGallery from './ProjectGallery.astro';
import BeforeAfter from './BeforeAfter.astro';
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section id="realizacje" class="band bg-paper-dim">
  <div class="wrap">
    <SectionHeading kicker={t.gallery.kicker} title={t.gallery.title} />
    <ProjectGallery locale={locale} />
    <div class="mt-16">
      <BeforeAfter locale={locale} />
    </div>
  </div>
</section>
