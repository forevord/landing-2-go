---
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

{/* Three short objections and their answers. Stacked in one column inside the
    content rail they ran to 1006px — a full screen and a half of scrolling for
    six sentences, with the caption rail empty beside all of it. Side by side
    they also read better: the visitor sees that every objection has an answer
    before reading any of them.

    The line icons are gone. A document, a calendar and a shield say nothing the
    quote beneath them does not already say, and generic line clipart is exactly
    what makes a page look templated. `item.icon` stays in the dictionary; if a
    real icon set ever arrives it can come back. */}
<section class="section">
  <div class="mx-auto max-w-page px-6 lg:px-10">
    <div class="split">
      <p class="t-label text-ink">{t.pain.title}</p>
      <h2 class="t-h2 max-w-[26ch] text-ink">{t.pain.lead}</h2>
    </div>

    <ul class="mt-12 grid gap-8 border-t border-border pt-8 md:grid-cols-3 md:gap-10">
      {
        t.pain.items.map((item, index) => (
          <li data-reveal style={`transition-delay:${index * 50}ms`}>
            <p class="t-h3 text-ink">“{item.quote}”</p>
            <p class="mt-3 text-muted">{item.answer}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
