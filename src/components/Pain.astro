---
import Icon from './Icon.astro';
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section class="section">
  <div class="mx-auto max-w-page px-6 lg:px-10">
    <div class="split">
      <p class="t-label text-ink">{t.pain.title}</p>

      <div>
        <h2 class="t-h2 max-w-[26ch] text-ink">{t.pain.lead}</h2>

        <ul class="mt-12 grid">
          {
            t.pain.items.map((item, index) => (
              <li
                class="border-t border-border py-8"
                data-reveal
                style={`transition-delay:${index * 50}ms`}
              >
                <Icon name={item.icon as 'shield-check'} class="h-5 w-5 text-muted" />
                <p class="t-h3 mt-4 text-ink">“{item.quote}”</p>
                <p class="mt-3 max-w-[60ch] text-muted">{item.answer}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
