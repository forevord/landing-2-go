---
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const l = getDictionary(locale).gallery.lightbox;
---

{
  /* One native dialog for every project: Esc, the focus trap and the top layer
    come from the platform. Slides are a scroll-snap track, so swiping is the
    browser's own gesture and needs no touch code. */
}
<dialog class="lightbox" aria-label={l.label} data-lightbox-dialog>
  <div class="lightbox__bar">
    <p class="lightbox__title" data-lb-title></p>
    <p class="lightbox__count" data-lb-count aria-live="polite"></p>
    <button type="button" class="lightbox__btn" data-lb-close aria-label={l.close}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
    </button>
  </div>
  <ul class="lightbox__track" data-lb-track></ul>
  <button
    type="button"
    class="lightbox__btn lightbox__nav lightbox__nav--prev"
    data-lb-prev
    aria-label={l.prev}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
  </button>
  <button
    type="button"
    class="lightbox__btn lightbox__nav lightbox__nav--next"
    data-lb-next
    aria-label={l.next}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
  </button>
</dialog>

<script>
  import '../scripts/lightbox';
</script>
