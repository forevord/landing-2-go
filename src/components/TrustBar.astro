---
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

{
  /* The reference's two-column block: the caption names the band on the left,
    the figures sit beside it. The boxed four-cell grid this replaced was the
    one place on the page that drew a border around content. */
}
<section class="section border-b border-border" aria-labelledby="trust-title">
  <div class="mx-auto max-w-page px-6 lg:px-10">
    <div class="split">
      <p class="t-label text-ink" id="trust-title">{t.trust.srTitle}</p>

      <ul class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4">
        {
          t.trust.items.map((item) => (
            <li class="min-w-0">
              <span class="t-h2 block break-words text-ink">{item.value}</span>
              <span class="t-label mt-2 block text-muted">{item.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
