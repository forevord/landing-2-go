---
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section class="border-b border-border bg-bg" aria-label={t.trust.srTitle}>
  <ul class="mx-auto grid max-w-page grid-cols-2 divide-x divide-y divide-border border-t border-border px-6 md:grid-cols-4 md:divide-y-0 lg:px-10">
    {
      t.trust.items.map((item) => (
        <li class="min-w-0 px-4 py-8 text-center sm:px-6">
          <span class="t-h2 block break-words text-ink">{item.value}</span>
          <span class="t-label mt-2 block text-graphite">{item.label}</span>
        </li>
      ))
    }
  </ul>
</section>
