---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/photos/hero.jpg';
import LeadForm from './LeadForm.astro';
import Icon from './Icon.astro';
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  phone: string;
}

const { locale, phone } = Astro.props;
const t = getDictionary(locale);
const telHref = `tel:${phone.replace(/\s/g, '')}`;
---

{
  /* The band is graphite with reversed paper-white type. What changed against
    the previous version is how the photograph is held: a veil at 20% opacity
    turned the picture into grey noise and cost the first screen its only
    evidence, so the photograph now runs at full strength behind a directional
    scrim (`.hero-scrim`). The scrim, not the opacity, is what buys the
    contrast — see the measured floors in global.css. */
}
<section
  class="relative -mt-16 flex min-h-[520px] flex-col justify-center overflow-hidden bg-graphite pt-20 pb-10 text-white lg:min-h-[640px] lg:pt-24 lg:pb-16"
>
  <div class="absolute inset-0">
    <Image
      src={heroPhoto}
      alt=""
      widths={[640, 1024, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality={58}
      class="h-full w-full object-cover grayscale-[0.7] contrast-105"
    />
    <div class="hero-scrim absolute inset-0"></div>
  </div>

  {
    /* The sticky mobile bar watches this: it stays out of the way until the
      visitor has moved past the first screen. */
  }
  <div data-sticky-sentinel aria-hidden="true" class="absolute top-[480px] left-0 h-px w-px"></div>

  <div class="relative mx-auto w-full max-w-page px-6 lg:px-10">
    <div class="grid items-start gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      {
        /* min-w-0 on both columns: a grid item defaults to min-width:auto and
          refuses to shrink under its content's minimum, which pushed the whole
          band 6px past the viewport at 320. */
      }
      <div class="min-w-0 lg:pt-2">
        <p class="t-label max-w-[42ch]">{t.hero.eyebrow}</p>
        <h1 class="t-display mt-5 max-w-[22ch]">{t.hero.h1}</h1>
        <p class="t-lead mt-5 max-w-[46ch]">{t.hero.lead}</p>

        {
          /* Two actions, not one. The quote pill resolves to whichever form is
            nearest (see scripts/quote-cta.ts); the telephone is the second
            action because in this trade roughly half the enquiries arrive as a
            call, and burying the number in the header loses them. */
        }
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href="#formularz" data-cta-quote class="btn btn-paper">{t.hero.cta}</a>
          <a href={telHref} class="btn btn-ghost text-white">
            <Icon name="phone" class="h-4 w-4" />
            <span>{phone}</span>
          </a>
        </div>

        {
          /* The proof line the first screen had none of. These are the same four
            figures the standalone trust band used to carry a screen further
            down; carrying them twice would be padding, so that band is gone. */
        }
        <h2 class="sr-only">{t.trust.srTitle}</h2>
        <ul class="hero-proof mt-8 max-w-[46ch] lg:max-w-none">
          {
            t.trust.items.map((item) => (
              <li>
                <span class="t-num block">{item.value}</span>
                <span class="mt-1 block text-sm text-white/80">{item.label}</span>
              </li>
            ))
          }
        </ul>
      </div>

      {
        /* Below lg the card cannot fit above the fold with the headline, and the
          sticky bar clips its foot — so the pill above carries the mobile path
          to the full form instead. */
      }
      <div class="hidden min-w-0 lg:block">
        <LeadForm locale={locale} variant="compact" id="hero-form" />
      </div>
    </div>
  </div>
</section>
