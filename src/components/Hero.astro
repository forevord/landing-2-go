---
import { Image } from 'astro:assets';
// The hero shares its photograph with the lead gallery project.
import heroPhoto from '../assets/projects/brama-lamele-pionowe/01.jpg';
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  phone: string;
}

const { locale, phone } = Astro.props;
const t = getDictionary(locale);
const telHref = `tel:${phone.replace(/\s/g, '')}`;
---

<section class="hero relative">
  {
    /* The sticky mobile bar watches this: it stays out of the way until the
      visitor has moved past the first screen. */
  }
  <div data-sticky-sentinel aria-hidden="true" class="absolute top-[480px] left-0 h-px w-px"></div>

  <div class="wrap hero-grid">
    <div class="min-w-0">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1>{t.hero.h1}</h1>
      <ul class="lead-list" aria-label={t.hero.pointsLabel}>
        {t.hero.points.map((point) => <li>{point}</li>)}
      </ul>
      <div class="flex flex-wrap gap-3.5">
        <a class="btn btn-primary" href="#formularz" data-cta-quote>{t.hero.cta}</a>
        <a class="btn btn-ghost" href={telHref}>{phone}</a>
      </div>
    </div>

    <div class="min-w-0">
      <Image
        src={heroPhoto}
        alt={t.hero.imageAlt}
        widths={[480, 720, 960, 1400]}
        sizes="(min-width: 820px) 480px, 100vw"
        loading="eager"
        fetchpriority="high"
        quality={72}
        class="hero-photo"
      />
    </div>
  </div>

  <div class="stats">
    <h2 class="sr-only">{t.trust.srTitle}</h2>
    <ul class="wrap stats-row">
      {
        t.trust.items.map((item) => (
          <li class="stat">
            <b>{item.value}</b>
            <span>{item.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
