---
import SectionHeading from './SectionHeading.astro';
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section id="proces" class="band bg-graphite text-paper">
  <div class="wrap">
    <SectionHeading kicker={t.process.kicker} title={t.process.title} tone="dark" />

    <ol class="four-up proc-list">
      {
        t.process.steps.map((step, index) => (
          <li class="proc" data-reveal style={`transition-delay:${index * 50}ms`}>
            <p class="proc__num" aria-hidden="true">
              {step.num}
            </p>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
            <p class="proc__time">{step.badge}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
