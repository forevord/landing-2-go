---
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section id="proces" class="bg-ink py-24 text-white lg:py-32">
  <div class="mx-auto max-w-page px-6 lg:px-10">
    <h2 class="t-h2">{t.process.title}</h2>
    <p class="t-lead mt-4 max-w-[60ch] text-white/70">{t.process.lead}</p>

    <ol class="mt-16 grid divide-y divide-ink-soft border-t border-ink-soft md:grid-cols-4 md:divide-x md:divide-y-0">
      {
        t.process.steps.map((step, index) => (
          <li
            class="relative py-8 md:px-8 md:first:pl-0"
            data-reveal
            style={`transition-delay:${index * 50}ms`}
          >
            <span class="t-display block text-white/35" aria-hidden="true">
              {step.num}
            </span>
            <h3 class="t-h3 mt-4">{step.title}</h3>
            <p class="mt-2 text-white/70">{step.desc}</p>
            <span class="mt-4 inline-block border border-ink-soft px-2 py-1 text-xs text-white/60">
              {step.badge}
            </span>
          </li>
        ))
      }
    </ol>

    <a href="#formularz" class="btn btn-primary mt-12">{t.process.cta}</a>
  </div>
</section>
