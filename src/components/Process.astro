---
import { getDictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

{/* Graphite, not black: the reference's three surfaces are gunmetal, paper and
    graphite, and the dark band is meant to echo the anodised finish in the
    photographs. Every rule and muted tone below is a white alpha — graphite on
    graphite would be invisible and graphite on black measures 2.09:1. */}
<section id="proces" class="section bg-graphite text-white">
  <div class="mx-auto max-w-page px-6 lg:px-10">
    <div class="split">
      <p class="t-label">{t.process.title}</p>
      <h2 class="t-h2 max-w-[26ch]">{t.process.lead}</h2>
    </div>

    <ol class="mt-20 grid divide-y divide-white/20 border-t border-white/20 md:grid-cols-4 md:divide-x md:divide-y-0">
      {
        t.process.steps.map((step, index) => (
          <li
            class="relative py-8 md:px-8 md:first:pl-0"
            data-reveal
            style={`transition-delay:${index * 50}ms`}
          >
            <span class="t-display block text-white/50" aria-hidden="true">
              {step.num}
            </span>
            <h3 class="t-h3 mt-4">{step.title}</h3>
            <p class="mt-2 text-white/75">{step.desc}</p>
            <span class="mt-4 inline-block rounded-control border border-white/30 px-2 py-1 text-xs text-white/75">
              {step.badge}
            </span>
          </li>
        ))
      }
    </ol>

    <a href="#formularz" class="btn btn-paper mt-12">{t.process.cta}</a>
  </div>
</section>
