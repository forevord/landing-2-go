---
interface Props {
  kicker?: string;
  title: string;
  /** Optional supporting paragraph under the heading. */
  lead?: string;
  /** `dark` is for the graphite bands, where the accent shifts to its light tint. */
  tone?: 'light' | 'dark';
  class?: string;
}

const { kicker, title, lead, tone = 'light', class: className } = Astro.props;
---

<div class:list={['section-head', tone === 'dark' && 'section-head--dark', className]}>
  {kicker && <p class="kicker">{kicker}</p>}
  <h2>{title}</h2>
  {lead && <p class="section-head__lead">{lead}</p>}
</div>
