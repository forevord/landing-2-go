---
import { Image, getImage } from 'astro:assets';
import Lightbox from './Lightbox.astro';
import { getDictionary, type Locale } from '../i18n';
import { getProjects, photoCount } from '../lib/projects';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const g = getDictionary(locale).gallery;
const projects = getProjects(g.projects);

// Everything the lightbox needs, rendered once at build time. Each link's href
// is the full-size photo, so without JavaScript a click still opens it.
const lightboxData = await Promise.all(
  projects.map(async (project) => ({
    id: project.id,
    title: project.title,
    photos: await Promise.all(
      project.photos.map(async ({ image, alt }) => {
        const large = await getImage({ src: image, widths: [960, 1600], format: 'webp' });
        return {
          src: large.src,
          srcset: large.srcSet.attribute,
          width: large.attributes.width,
          height: large.attributes.height,
          alt,
        };
      }),
    ),
  })),
);
const fullSize = (projectIndex: number, photoIndex: number) =>
  lightboxData[projectIndex].photos[photoIndex].src;

const [feature, ...rest] = projects;
const THUMBS = 4;
const featureThumbs = feature.photos.slice(1, 1 + THUMBS);
const hiddenAfterThumbs = feature.photos.length - 1 - featureThumbs.length;
const openLabel = (count: number, title: string) =>
  `${g.open} ${photoCount(count, locale, g.photos)}: ${title}`;
---

{
  /* One project per block, so a visitor sees whole jobs rather than a stream of
    unrelated gates. The newest project leads as a wide feature with its other
    shots in a strip; the rest follow as two-up cards. Every photo opens the
    shared lightbox at that photo, scoped to its own project. */
}
<div class="projects">
  <article class="project-feature">
    <a
      class="project-cover project-feature__cover"
      href={fullSize(0, 0)}
      data-lightbox={feature.id}
      data-index="0"
      aria-label={openLabel(feature.photos.length, feature.title)}
    >
      <Image
        src={feature.photos[0].image}
        alt=""
        widths={[480, 800, 1200]}
        sizes="(min-width: 1080px) 614px, 100vw"
        loading="lazy"
        quality={72}
      />
    </a>

    <div class="project-feature__body">
      <h3>{feature.title}</h3>
      <p class="project__summary">{feature.summary}</p>
      <ul class="project__scope">
        {feature.scope.map((item) => <li>{item}</li>)}
      </ul>
      <a class="link-arrow" href={fullSize(0, 0)} data-lightbox={feature.id} data-index="0">
        {`${g.open} ${photoCount(feature.photos.length, locale, g.photos)}`}
      </a>
    </div>

    {
      featureThumbs.length > 0 && (
        <ul class="project-thumbs">
          {featureThumbs.map((photo, i) => {
            const index = i + 1;
            const isLast = i === featureThumbs.length - 1 && hiddenAfterThumbs > 0;
            return (
              <li>
                <a
                  class="project-cover"
                  href={fullSize(0, index)}
                  data-lightbox={feature.id}
                  data-index={index}
                >
                  <Image
                    src={photo.image}
                    alt={photo.alt}
                    widths={[240, 400]}
                    sizes="(min-width: 820px) 256px, 40vw"
                    loading="lazy"
                    quality={70}
                  />
                  {isLast && (
                    <span class="project-thumbs__more" aria-hidden="true">
                      +{hiddenAfterThumbs}
                    </span>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </article>

  {
    rest.length > 0 && (
      <ul class="project-grid">
        {rest.map((project, i) => (
          <li>
            <article class="project-card">
              <a
                class="project-cover project-card__cover"
                href={fullSize(i + 1, 0)}
                data-lightbox={project.id}
                data-index="0"
                aria-label={openLabel(project.photos.length, project.title)}
              >
                <Image
                  src={project.photos[0].image}
                  alt=""
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 820px) 512px, 100vw"
                  loading="lazy"
                  quality={72}
                />
              </a>
              <h3>{project.title}</h3>
              <p class="project__summary">{project.summary}</p>
              <a
                class="link-arrow"
                href={fullSize(i + 1, 0)}
                data-lightbox={project.id}
                data-index="0"
              >
                {`${g.open} ${photoCount(project.photos.length, locale, g.photos)}`}
              </a>
            </article>
          </li>
        ))}
      </ul>
    )
  }
</div>

<Lightbox locale={locale} />
<script type="application/json" id="lightbox-data" set:html={JSON.stringify(lightboxData)} />
